{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "/tmp/verify",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/types.ts", "src/utils", "src/data", "scripts"]
}
